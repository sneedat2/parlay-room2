# Copy this file to .env and fill it in.

# ---- Where odds come from ----
# SportsGameOdds (sportsgameodds.com): used automatically when this key is set.
SGO_API_KEY=
# The Odds API (the-odds-api.com): used when there's no SGO_API_KEY (or ODDS_PROVIDER=oddsapi).
# With BOTH keys set, SGO supplies the odds and The Odds API only supplies FanDuel betslip codes
# for legs on a slip (SGO's codes don't open FanDuel's betslip in every state). ~1-2 credits per game+market.
ODDS_API_KEY=
# Optional: force one source, "sgo" or "oddsapi". With no key at all, the app uses demo odds.
ODDS_PROVIDER=
# SportsGameOdds bills per game returned. How long to keep a sport's game list, and one game's odds (minutes).
SGO_LIST_MINUTES=30
SGO_EVENT_MINUTES=10

# Optional. If set, people need this code to CREATE a new group
# (joining a group only needs that group's invite code).
# Set it once the app is online so strangers can't use up your API credits.
GROUP_CREATE_CODE=

# Email for "Forgot PIN" codes. Brevo (brevo.com) is free for 300 emails/day and
# doesn't need a website domain: verify your own email as a sender there, then
# create an API key under SMTP & API > API Keys.
BREVO_API_KEY=
# The sender address you verified in Brevo
MAIL_FROM=
MAIL_FROM_NAME=Parlay Room
# Or use Resend instead of Brevo (needs a domain you own to email other people)
RESEND_API_KEY=

# Your FanDuel state, e.g. nj, pa, oh, az (only used if FanDuel links need it)
FANDUEL_STATE=

# How long odds are cached, in seconds. Higher = fewer API credits used.
ODDS_CACHE_SECONDS=120

# How often slip odds update on their own while someone has the group open (minutes, per group).
# "Update odds now" on the slip always fetches fresh odds on demand.
# Screens nobody has touched for 10 minutes stop asking for odds until someone taps or scrolls again.
SLIP_ODDS_MINUTES=10

# Free vs Pro limits (1 group, 1 slip, 5 legs, main lines only for free accounts).
# Off by default while testing: everyone gets every feature. Set to "on" to turn the limits on.
PRO_LIMITS=off

# Accounts that get Pro when PRO_LIMITS is on, comma-separated.
# Stand-in until app store subscriptions are hooked up.
PRO_EMAILS=

PORT=3000
